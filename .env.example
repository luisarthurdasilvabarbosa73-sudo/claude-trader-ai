# Modelo de variáveis. NÃO coloque valores reais neste arquivo.
# Na nuvem, cadastre cada variável no painel do provedor (aba "Variables").

# --- Obrigatórias ---
APP_ENV=production
# Senha para entrar no app (mínimo 10 caracteres)
ADMIN_PASSWORD=
# Chave aleatória para assinar o login (mínimo 32 caracteres). Ex.: gere em https://www.random.org/strings/
SECRET_KEY=

# --- Robô ---
TRADING_MODE=SIMULACAO
INITIAL_CAPITAL_BRL=30
QUOTE_ASSET=USDT
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,ADAUSDT
TIMEZONE=America/Fortaleza
AUTO_RESUME=true
DATABASE_PATH=/data/trader.db

# --- IA (opcional; o robô funciona sem) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Binance (NÃO necessário nesta etapa: simulação usa só dados públicos) ---
# Serão usadas apenas a partir da ETAPA 9 (Testnet). Nunca crie chave com saque.
BINANCE_API_KEY=
BINANCE_API_SECRET=
REAL_TRADING_ENABLED=false
